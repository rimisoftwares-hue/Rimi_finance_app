# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Environment mode ('development' or 'production')
NODE_ENV=development

# Port where Express HTTP & WebSocket server will listen
PORT=3004

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database host (e.g., localhost or cloud PostgreSQL host)
DB_HOST=localhost

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Database name
DB_NAME=rimi_finance_db

# Database user
DB_USER=postgres

# Database password
DB_PASSWORD=your_database_password_here

# SSL mode: 'require' for remote cloud databases (e.g., Aiven, AWS RDS) or 'disable' for local Postgres
DB_SSLMODE=disable

# Test safety guard: when NODE_ENV=test, database.config.js refuses non-local DB_HOST unless set to 'true'
ALLOW_REMOTE_DB_IN_TESTS=false

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JSON Web Tokens (use a strong random string)
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# JWT expiration duration (e.g., 1d, 7d, 30d, 90d)
JWT_EXPIRES=90d

# Optional secondary JWT secret if used by finance module
JWT_FINANCE_SECRET=your_finance_jwt_secret_key_change_me

# ------------------------------------------------------------------------------
# 4. AWS S3 File Storage (Customer & Vehicle Document Uploads)
# ------------------------------------------------------------------------------
# Active AWS S3 variables used in routes (auth, customers, vehicles)
BUCKET_NAME=your_s3_bucket_name
BUCKET_REGION=ap-south-1
ACCESS_KEY=your_aws_access_key_id
SECRET_ACCESS_KEY=your_aws_secret_access_key

# Standard AWS SDK alias fallbacks (if needed)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# ------------------------------------------------------------------------------
# 5. CORS & Frontend URLs
# ------------------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (never use wildcard '*' with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3003,tauri://localhost,http://tauri.localhost,https://tauri.localhost
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:3003,http://localhost:3004,tauri://localhost

# Frontend application URL
FRONTEND_URL=http://localhost:5173

# Backend API base URL
API_BASE_URL=http://localhost:3004

# ------------------------------------------------------------------------------
# 6. Login Location Policy (strict | prefer | off)
# ------------------------------------------------------------------------------
LOGIN_LOCATION_POLICY=prefer

# ------------------------------------------------------------------------------
# 7. OCR Ledger-Card Import (AI Scan) — NAMES ONLY, never commit real values
# ------------------------------------------------------------------------------
# Tables come from sql/migrations/006_create_ocr_tables.sql (run manually, dev DB first).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=LOW
GEMINI_TIMEOUT_MS=90000
# Use 16384 only when OCR_EXTRACT_PAYMENTS=true
GEMINI_MAX_OUTPUT_TOKENS=8192
OCR_ENABLED=false
OCR_MAX_IMAGES=1
OCR_MAX_FILE_BYTES=8388608
OCR_WORKER_ENABLED=false
OCR_WORKER_CONCURRENCY=5
OCR_PER_FINANCE_CONCURRENCY=3
OCR_DIRECT_CONCURRENCY=8
OCR_DIRECT_QUEUE_MAX=20
OCR_DIRECT_QUEUE_WAIT_MS=20000
# Per worker process; divide between processes if more than one worker runs
OCR_MAX_RPS=10
OCR_IMAGE_MAX_EDGE_PX=2048
OCR_S3_RETENTION_DAYS=7
# Keep true until the owner explicitly flips it (deletes S3 images + erases extracted data)
OCR_S3_SWEEP_DRY_RUN=true
OCR_EXTRACT_PAYMENTS=false
OCR_DAILY_LIMIT_PER_FINANCE=200
OCR_USER_BATCHES_PER_MINUTE=6

# ------------------------------------------------------------------------------
# 8. Two-Factor Authentication (TOTP Authenticator App + Step-Up Security)
# ------------------------------------------------------------------------------
# Issuer label displayed inside Google Authenticator / Microsoft Authenticator / Authy
TWO_FACTOR_ISSUER=AutoFinex

# 32-byte (64 hex chars) AES-256-GCM key used to encrypt TOTP secrets at rest in PostgreSQL.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=your_64_hex_char_aes_256_gcm_master_key_here

# Dedicated secret for signing short-lived 2FA pre-auth, step-up, and password-reset tokens
# (MUST be different from JWT_SECRET so pre-auth tokens can never act as session tokens).
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_CHALLENGE_SECRET=your_64_hex_char_2fa_challenge_jwt_secret_here

# Allowed 30-second clock drift steps for Authenticator TOTP codes (1 = ±30s)
TWO_FACTOR_TOTP_WINDOW=1

# WhatsApp OTP validity, resend cooldown, max verification attempts, and step-up grant TTL
TWO_FACTOR_OTP_TTL_SECONDS=300
TWO_FACTOR_OTP_RESEND_COOLDOWN_SECONDS=60
TWO_FACTOR_OTP_MAX_ATTEMPTS=5
TWO_FACTOR_STEP_UP_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# 9. WhatsApp Business Cloud API (Meta Graph API — OTP & Security Alerts)
# ------------------------------------------------------------------------------
# Delivery provider:
#   - meta_cloud  : Official Meta WhatsApp Business Cloud API (production)
#   - console_dev : Logs OTP in backend console ONLY when NODE_ENV=development (blocked in prod)
#   - disabled    : Disables WhatsApp OTP channel
WHATSAPP_PROVIDER=meta_cloud

# Meta Graph API version
WHATSAPP_GRAPH_API_VERSION=v21.0

# Meta Business System User Permanent Access Token (from Meta Business Settings -> System Users)
WHATSAPP_ACCESS_TOKEN=your_meta_permanent_system_user_token_here

# Meta WhatsApp Phone Number ID (numeric ID from Meta App -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id_here

# Meta WhatsApp Business Account ID (WABA ID — optional, used for template/health checks)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_waba_id_here

# Meta App Secret (used to verify X-Hub-Signature-256 on optional delivery webhooks)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Custom verify token if configuring Meta Webhook callback URL (optional)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Approved Meta WhatsApp "Authentication" category template name & language code
WHATSAPP_OTP_TEMPLATE_NAME=autofinex_auth_otp
WHATSAPP_OTP_TEMPLATE_LANG=en_US

# Default E.164 country calling code prepended to 10-digit user phone numbers (91 = India)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Outbound HTTP timeout in milliseconds for Meta Graph API requests
WHATSAPP_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 10. Voice AI Control Plane Integration (Fail-Closed Mock Default)
# ------------------------------------------------------------------------------
VOICE_AGENT_BASE_URL=http://127.0.0.1:8100
VOICE_GATEWAY_HEALTH_URL=http://127.0.0.1:8000/api/v1/health
VOICE_AI_INTERNAL_HMAC_SECRET=your_voice_ai_internal_hmac_secret_here
# Fail-closed telephony mode ('mock' | 'live_allowlist' | 'live'); defaults strictly to 'mock'
VOICE_TELEPHONY_MODE=mock
# Emergency kill switch ('true' halts all outbound Voice AI dispatches with HTTP 503)
VOICE_AI_KILL_SWITCH=false
# Explicit live dialing confirmation gate (required in addition to VOICE_TELEPHONY_MODE=live)
VOICE_LIVE_CALLS_CONFIRMED=false
# Comma-separated E.164 numbers allowed when VOICE_TELEPHONY_MODE=live_allowlist (e.g. +919000001001,+919000001002)
TEST_ALLOWED_NUMBERS=


