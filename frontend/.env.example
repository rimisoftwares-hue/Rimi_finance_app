VITE_API_URL=http://localhost:3004
VITE_API_BASE_URL=http://localhost:3004/api
VITE_FRONTEND_URL=http://localhost:3003

# Base map. OSM's public tile server is for light use only. For production volume, switch to a keyed provider here.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Satellite (Esri World Imagery, with place labels overlay). Review Esri terms for commercial use.
VITE_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_LABELS_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}

# Optional. Leave EMPTY to hide the Traffic button (there is no free traffic layer).
# Example shape for a keyed provider: https://<provider>/traffic/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_TRAFFIC_TILE_URL=

# Defaults when no pin/markers exist (state-level view). "lat,lng"
VITE_MAP_DEFAULT_CENTER=11.1271,78.6569
VITE_MAP_DEFAULT_ZOOM=7

# Geocoding (search suggestions via Photon, reverse geocoding via Nominatim)
VITE_GEOCODER_BBOX=68.1,6.5,97.4,35.7
VITE_GEOCODER_COUNTRY=in
VITE_GEOCODER_EMAIL=

