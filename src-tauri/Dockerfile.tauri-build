# ───────────────────────────────────────────────────────────────
# Tauri Build Environment (Version Locked)
# Produces Linux binaries (.AppImage / .deb)
# ───────────────────────────────────────────────────────────────

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# ───────────────────────────────────────────────────────────────
# 1. System Dependencies (Tauri + WebKit + Build Tools)
# ───────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    wget \
    git \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.0-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libfuse2 \
    squashfs-tools \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ───────────────────────────────────────────────────────────────
# 2. Install Node.js v20.x (Locked)
# ───────────────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    node -v

# ───────────────────────────────────────────────────────────────
# 3. Install Rust v1.92.0 (Locked)
# ───────────────────────────────────────────────────────────────
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH=/usr/local/cargo/bin:$PATH

RUN curl https://sh.rustup.rs -sSf | sh -s -- -y --no-modify-path \
        --default-toolchain 1.92.0 \
        --profile minimal && \
    rustc --version && cargo --version

# ───────────────────────────────────────────────────────────────
# 4. Install Tauri CLI v2.9.6 (Locked)
# ───────────────────────────────────────────────────────────────
RUN cargo install tauri-cli --version 2.9.6 --locked

# ───────────────────────────────────────────────────────────────
# 5. Set Working Directory
# ───────────────────────────────────────────────────────────────
WORKDIR /app

# ───────────────────────────────────────────────────────────────
# 6. Cache Rust Dependencies (Faster Builds)
# ───────────────────────────────────────────────────────────────
COPY src-tauri/Cargo.toml src-tauri/Cargo.lock* ./src-tauri/

RUN mkdir -p src-tauri/src && \
    echo 'fn main() {}' > src-tauri/src/main.rs && \
    echo 'pub fn lib() {}' > src-tauri/src/lib.rs && \
    cd src-tauri && cargo fetch

# ───────────────────────────────────────────────────────────────
# 7. Copy Full Project
# ───────────────────────────────────────────────────────────────
COPY . .

# ───────────────────────────────────────────────────────────────
# 8. Build Frontend
# ───────────────────────────────────────────────────────────────
WORKDIR /app/frontend
RUN npm ci && npm run build

# ───────────────────────────────────────────────────────────────
# 9. Build Tauri App
# ───────────────────────────────────────────────────────────────
WORKDIR /app
RUN cargo tauri build --bundles appimage deb

# ───────────────────────────────────────────────────────────────
# 10. Show Build Output
# ───────────────────────────────────────────────────────────────
RUN echo "=== BUILD COMPLETE ===" && \
    find src-tauri/target/release/bundle -type f

# ───────────────────────────────────────────────────────────────
# Default Command
# ───────────────────────────────────────────────────────────────
CMD ["find", "src-tauri/target/release/bundle", "-type", "f"]